{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "scripts/**", "test/**", "*.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "assist": {
